  "scope_held_fixed": "固定同一天输入；上一轮dispatch17状态、全部训练超参、储能、新能源、满意度及参与率公式、零噪声设置、零售价界与利润目标。仅修改下面24对a,b。响应参考价由a,b自洽导出，用于原状态中已有对应特征。",
  "utility_convention": {
    "aggregate": "U_t(L)=a_t*L^2+b_t*L, a_t<0; maximize U_t(L)-p*L gives rational L=(p-b_t)/(2*a_t).",
    "forward_mapping": "a_t=-kappa_t; b_t=reference_t+2*kappa_t*L0_t.",
    "inverse_mapping": "kappa_t=-a_t; reference_t=b_t+2*a_t*L0_t.",
    "class_mapping": "For class share s_j, a_tj=a_t/s_j and b_tj=b_t. Then L_tj=s_j*(p-b_t)/(2*a_t)=L0_tj+(p-reference_t)/(2*a_tj). Do not give every class the same aggregate a_t.",
    "actual_response": "以上仅是理性需求层。最终负荷继续使用原3次满意度/参与率迭代，含原非负负荷处理；不把理性最优解替代实际响应。",
    "baseline_dependency": "b_t用本次固定名义L0构造。未来若改变基准负荷，固定a,b与固定reference是不同模型；本文件只对应当前固定日。",
    "units": "沿当前建模假设：L是1小时负荷/电量数值，p为澳分/kWh；b与p同单位，a为电价/负荷单位。单位仍属项目假设，非原始数据已核实事实。"
  },
  "construction": {
    "window": "w_t=(1+cos(pi*(t-11)/5))/2 for abs(t-11)<=5, otherwise 0; hour is zero-based 0..23.",
    "curvature": "kappa_t=0.0011*(1-0.20*w_t)",
    "reference": "reference_t=previous_reference_t+1.8*w_t",
    "modified_hours": [
      7,
      8,
      9,
